---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Business — Arata Horie" description="Haptics technology research, development, and social implementation through commissure Inc.">
  <Header />

  <section class="business-page">
    <div class="container">
      <header class="page-header animate-on-scroll">
        <span class="section-label">Business</span>
        <h1>Research to Reality</h1>
        <div class="page-lead-cols">
          <p class="page-lead">
            Deploying haptics research and know-how cultivated in academia into society through <a href="https://commissure.co.jp/" target="_blank" rel="noopener" class="link-accent">commissure Inc.</a>
            From R&D of haptic technology to experience design and device provision.
          </p>
          <p class="page-lead-ja">
            アカデミアで培った触覚技術（ハプティクス）に関する知財・ノウハウを <a href="https://commissure.co.jp/" target="_blank" rel="noopener" class="link-accent">commissure Inc.</a> を通じて社会実装します。
            触覚技術の研究開発から体験設計、デバイス提供まで、触覚にまつわる課題解決に貢献します。
          </p>
        </div>
      </header>

      <!-- Vision -->
      <div class="vision-section animate-on-scroll">
        <div class="vision-content">
          <h2 class="vision-title">身体を通じて「できる」「わかる」喜びが循環する社会へ</h2>
          <p class="vision-title-en">Toward a Society Where the Joy of Capability Circulates</p>
          <div class="vision-cols">
            <div class="vision-col-ja">
              <p>
                身体感覚を<strong>保存・再生・生成</strong>する技術によって、
                これまで共有が難しかった身体の知をデジタル化し、
                誰もが活用できる「感覚資産」として社会に届けることをビジョンとして掲げています。
              </p>
            </div>
            <div class="vision-col-en">
              <p>
                Through technology that <strong>records, reproduces, and generates</strong> bodily sensations,
                we digitize embodied knowledge that was previously difficult to share, and deliver it
                to society as "sensory assets" that anyone can utilize.
              </p>
            </div>
          </div>
        </div>
        <div class="vision-meta">
          <div class="company-logo-wrap">
            <img src={`${base}/images/commissure-logo.png`} alt="commissure Inc." class="company-logo" />
          </div>
          <div class="meta-item">
            <span class="meta-label">Founded</span>
            <span class="meta-value">2023.01</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Role</span>
            <span class="meta-value">Founder & CTO</span>
            <span class="meta-value-ja">代表取締役 CTO</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Origin</span>
            <span class="meta-value">UTokyo RCAST / JST ERATO</span>
          </div>
        </div>
      </div>

      <!-- Products -->
      <div class="products-section">
        <h2 class="section-heading animate-on-scroll">Products & Solutions</h2>
        <div class="products-grid">
          <div class="product-card animate-on-scroll">
            <h3>FeelFuse®</h3>
            <p class="product-type">Display</p>
            <div class="product-cols">
              <p class="product-ja">触覚フィードバック提示デバイス。皮膚せん断・振動提示により、バーチャル空間の触感やスキルの追体験を可能にする。</p>
              <p class="product-en">A haptic feedback device. Enables re-experiencing virtual textures and skills through skin-stretch and vibration.</p>
            </div>
          </div>
          <div class="product-card animate-on-scroll">
            <h3>SenseFuse®</h3>
            <p class="product-type">Sensing</p>
            <div class="product-cols">
              <p class="product-ja">人間の触覚データを現場で収集するセンサーデバイス。Force Myography（筋変形計測）により、身体の力加減や動きのニュアンスをデジタル化。</p>
              <p class="product-en">A sensor device for collecting human haptic data in the field. Digitizes the nuances of body force and movement through Force Myography (FMG).</p>
            </div>
          </div>
          <div class="product-card animate-on-scroll">
            <h3>HaptoScala®</h3>
            <p class="product-type">Toolkit</p>
            <div class="product-cols">
              <p class="product-ja">開発者・デザイナー向けマルチチャネル触覚提示システムツールキット。振動・力覚それぞれを提示可能なシステムをスケーラブルに構築可能。</p>
              <p class="product-en">A multi-channel haptic display toolkit for developers and designers. Enables easy prototyping of complex haptic feedback including vibration, force, and thermal sensations.</p>
            </div>
          </div>
          <div class="product-card animate-on-scroll">
            <h3>HaptoAI®</h3>
            <p class="product-type">Generation</p>
            <div class="product-cols">
              <p class="product-ja">触覚コンテンツ生成AI。テキストや音声から触覚パターンを自動生成し、コンテンツ制作の効率と創造性を飛躍的に向上。</p>
              <p class="product-en">Haptic content generation AI. Automatically generates haptic patterns from text and audio, dramatically improving content creation efficiency and creativity.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Technology Flow 
      <div class="flow-section animate-on-scroll">
        <h2 class="section-heading">Research → Product</h2>
        <div class="flow-diagram">
          <div class="flow-step">
            <span class="flow-number">01</span>
            <span class="flow-label">Research</span>
            <span class="flow-desc">大学での基礎研究</span>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <span class="flow-number">02</span>
            <span class="flow-label">Prototype</span>
            <span class="flow-desc">技術PoC開発</span>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <span class="flow-number">03</span>
            <span class="flow-label">Product</span>
            <span class="flow-desc">commissureでの製品化</span>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <span class="flow-number">04</span>
            <span class="flow-label">Deployment</span>
            <span class="flow-desc">社会実装・共同開発</span>
          </div>
        </div>
      </div> -->

      <!-- Case Studies -->
      <div class="cases-section">
        <h2 class="section-heading animate-on-scroll">Case Studies</h2>
        <div class="cases-grid">
          <div class="case-card animate-on-scroll">
            <div class="case-number">01</div>
            <h3>FEEL TECH Wear</h3>
            <p class="case-domain">Telecom × Haptic Experience Design</p>
            <div class="case-cols">
              <p class="case-ja">NTT docomoとのコラボレーションプロジェクト。FEEL TECHブランドのもと、触覚デバイスの設計・製作から体験コンテンツの設計・実装までを一貫して担当。新たな触覚体験価値を社会に提示した。</p>
              <p class="case-en">A collaboration project with NTT docomo under the FEEL TECH brand. End-to-end involvement from haptic device design and fabrication to experience content design and implementation, presenting new haptic experience prototypes to society.</p>
            </div>
          </div>
          <div class="case-card animate-on-scroll">
            <div class="case-number">02</div>
            <h3>CrafTouch</h3>
            <p class="case-domain">Traditional Craft × Haptics</p>
            <div class="case-cols">
              <p class="case-ja">伝統工芸における職人の技能を触覚データとして記録・再生。暗黙知の継承をデジタル触覚技術で革新する技能伝承プロジェクト。</p>
              <p class="case-en">Recording and reproducing craftspersons' skills as haptic data. A skill transfer project innovating tacit knowledge succession through digital haptic technology.</p>
            </div>
          </div>
          <div class="case-card animate-on-scroll">
            <div class="case-number">03</div>
            <h3>製造業における触覚スキル転移</h3>
            <p class="case-domain">Manufacturing × Skill Transfer</p>
            <div class="case-cols">
              <p class="case-ja">製造業における技能伝承プロジェクト。SenseFuseによる熟練職人の手の力加減・動きの計測と、FeelFuseによる触覚再生を組み合わせ、金型磨き技術のスキル転移を実現する。</p>
              <p class="case-en">A skill transfer project in manufacturing. Combining SenseFuse for measuring expert craftspersons' force and movement with FeelFuse for haptic reproduction to achieve skill transfer in mold polishing techniques.</p>
            </div>
          </div>
          <div class="case-card animate-on-scroll">
            <div class="case-number">04</div>
            <h3>ロボット遠隔操作支援のための触覚フィードバック</h3>
            <p class="case-domain">Robotics × Haptics</p>
            <div class="case-cols">
              <p class="case-ja">触覚フィードバックによるロボット遠隔操作支援システムの構築。触覚提示により、ロボット操作における手がかりを補強、模倣学習データのクオリティを向上させる。</p>
              <p class="case-en">Building a robot teleoperation support system using haptic feedback. Haptic presentation reinforces cues in robot operation and improves the quality of imitation learning data.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-section animate-on-scroll">
        <h2>Consulting on Haptics</h2>
        <p class="cta-sub-ja">ハプティクスに関するご相談</p>
        <div class="cta-cols">
          <p class="cta-en">We welcome all inquiries regarding haptic technology — research collaboration, technology adoption, and experience design.</p>
          <p class="cta-ja">研究連携・技術導入・体験設計など、触覚技術に関するあらゆるお問い合わせをお待ちしています。</p>
        </div>
        <a href={`${base}/contact`} class="btn btn-primary">Contact →</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .business-page {
    padding-top: calc(var(--header-height) + var(--space-3xl));
  }

  .page-header {
    max-width: 720px;
    margin-bottom: var(--space-3xl);
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .page-lead-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .page-lead {
    font-size: 1rem;
    line-height: 1.9;
  }

  .page-lead-ja {
    font-family: var(--font-ja);
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--text-tertiary);
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-lg);
  }

  .section-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
  }

  .link-accent {
    color: var(--accent-primary);
    border-bottom: 1px solid var(--border-accent);
    transition: opacity var(--duration-fast);
  }
  .link-accent:hover { opacity: 0.7; }

  /* Company Logo */
  .company-logo-wrap {
    padding-bottom: var(--space-lg);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
  }
  .company-logo {
    height: 28px;
    width: auto;
    object-fit: contain;
    opacity: 0.85;
  }

  /* Vision */
  .vision-section {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: var(--space-3xl);
    align-items: start;
    padding: var(--space-2xl) 0;
    margin-bottom: var(--space-3xl);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .vision-title {
    font-size: 1.6rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
    font-family: var(--font-ja);
  }

  .vision-title-en {
    font-family: var(--font-en);
    font-size: 0.88rem;
    color: var(--text-tertiary);
    font-style: italic;
    margin-bottom: var(--space-lg);
  }

  .vision-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .vision-col-ja p {
    font-family: var(--font-ja);
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  .vision-col-en p {
    font-family: var(--font-en);
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--text-tertiary);
  }

  .vision-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-left: var(--space-xl);
    border-left: 1px solid var(--border-subtle);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
  }

  .meta-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
    margin-bottom: 2px;
  }

  .meta-value {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .meta-value-ja {
    font-family: var(--font-ja);
    font-size: 0.72rem;
    color: var(--text-tertiary);
  }

  /* Products */
  .section-heading {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-xl);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }

  .product-card {
    padding: var(--space-xl);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-normal), box-shadow var(--duration-normal);
  }

  .product-card:hover {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-card);
  }

  .product-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
  }

  .product-type {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    margin-bottom: var(--space-md);
  }

  .product-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .product-ja {
    font-family: var(--font-ja);
    font-size: 0.82rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .product-en {
    font-family: var(--font-en);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--text-tertiary);
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-md);
  }

  /* Flow */
  .flow-section {
    margin-bottom: var(--space-3xl);
  }

  .flow-diagram {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-xl) 0;
  }

  .flow-step {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .flow-number {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--accent-primary);
    letter-spacing: 0.1em;
  }

  .flow-label {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .flow-desc {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    font-family: var(--font-ja);
  }

  .flow-arrow {
    font-size: 1.2rem;
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  /* Cases */
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }

  .case-card {
    padding: var(--space-xl);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-normal);
  }

  .case-card:hover {
    border-color: var(--accent-primary);
  }

  .case-number {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--accent-primary);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .case-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .case-domain {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--accent-primary);
    margin-bottom: var(--space-md);
  }

  .case-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .case-ja {
    font-family: var(--font-ja);
    font-size: 0.82rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .case-en {
    font-family: var(--font-en);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--text-tertiary);
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-md);
  }

  /* CTA */
  .cta-section {
    text-align: center;
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--border-subtle);
  }

  .cta-section h2 {
    font-size: 1.6rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    margin-bottom: 4px;
  }

  .cta-sub-ja {
    font-family: var(--font-ja);
    font-size: 0.88rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-lg);
  }

  .cta-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    text-align: left;
    max-width: 640px;
    margin: 0 auto var(--space-xl);
  }

  .cta-en {
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .cta-ja {
    font-family: var(--font-ja);
    font-size: 0.82rem;
    line-height: 1.8;
    color: var(--text-tertiary);
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-md);
  }

  @media (max-width: 768px) {
    .page-lead-cols { grid-template-columns: 1fr; }
    .page-lead-ja { border-left: none; padding-left: 0; border-top: 1px solid var(--border-subtle); padding-top: var(--space-sm); }
    .vision-section { grid-template-columns: 1fr; }
    .vision-cols { grid-template-columns: 1fr; }
    .vision-meta {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--border-subtle);
      padding-top: var(--space-lg);
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-xl);
    }
    .products-grid { grid-template-columns: 1fr; }
    .product-cols { grid-template-columns: 1fr; }
    .product-en { border-left: none; padding-left: 0; border-top: 1px solid var(--border-subtle); padding-top: var(--space-xs); }
    .cases-grid { grid-template-columns: 1fr; }
    .case-cols { grid-template-columns: 1fr; }
    .case-en { border-left: none; padding-left: 0; border-top: 1px solid var(--border-subtle); padding-top: var(--space-xs); }
    .cta-cols { grid-template-columns: 1fr; }
    .cta-ja { border-left: none; padding-left: 0; border-top: 1px solid var(--border-subtle); padding-top: var(--space-xs); }
    .flow-diagram { flex-direction: column; }
    .flow-arrow { transform: rotate(90deg); }
  }
</style>
