---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<Layout title="Research — Arata Horie">
  <Header />

  <section class="research-page">
    <div class="container">
      <header class="page-header animate-on-scroll">
        <span class="section-label">Research</span>
        <h1>All Projects</h1>
        <p class="page-desc">
          {projects.length} research projects on body-surface haptics and embodied experience, 2017–present.
        </p>
      </header>

      <div class="research-grid">
        {projects.map((project, i) => (
          <ProjectCard {...project} index={i} />
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .research-page {
    padding-top: calc(var(--header-height) + var(--space-3xl));
  }

  .page-header {
    margin-bottom: var(--space-2xl);
  }

  .section-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
    margin-bottom: var(--space-sm);
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-sm);
  }

  .page-desc {
    font-size: 0.9rem;
    max-width: 500px;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  @media (max-width: 1024px) {
    .research-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .research-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
