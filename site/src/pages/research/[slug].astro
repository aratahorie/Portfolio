---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

const allProjects = await getCollection('research');
// Sort by date descending (newest first)
allProjects.sort((a, b) => b.data.date.localeCompare(a.data.date));

export async function getStaticPaths() {
  const projects = await getCollection('research');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data: content } = project;
const { Content } = await render(project);

// Parse body for EN/JA split
const rawBody = project.body || '';
const jaSplit = rawBody.split('<!-- ja -->');
const descriptionEn = jaSplit[0].trim();
const descriptionJa = jaSplit.length > 1 ? jaSplit[1].trim() : '';

const projectIndex = allProjects.findIndex((p) => p.id === project.id);
const prevProject = projectIndex > 0 ? allProjects[projectIndex - 1] : null;
const nextProject = projectIndex < allProjects.length - 1 ? allProjects[projectIndex + 1] : null;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title={`${content.title} — Arata Horie`}>
  <Header />

  <article class="project-detail">
    <div class="container">
      <header class="detail-header">
        <div class="detail-meta animate-on-scroll">
          <span class="tag">{content.category}</span>
          <span class="detail-date">{content.date}</span>
        </div>
        <h1 class="detail-title animate-on-scroll">{content.title}</h1>
        {content.subtitle && (
          <p class="detail-subtitle animate-on-scroll">{content.subtitle}</p>
        )}
        {content?.awards && content.awards.length > 0 && (
          <div class="awards animate-on-scroll">
            {content.awards.map((award) => (
              <span class="award-badge">🏆 {award}</span>
            ))}
          </div>
        )}
      </header>

      {content.image && (
        <div class="hero-image animate-on-scroll">
          <img src={`${base}${content.image}`} alt={content.title} loading="eager" />
        </div>
      )}

      <div class="detail-body">
        <div class="detail-main">
          {descriptionEn && (
            <section class="content-section animate-on-scroll">
              <p class="description">{descriptionEn}</p>
            </section>
          )}

          {descriptionJa && (
            <section class="content-section animate-on-scroll">
              <p class="description text-ja">{descriptionJa}</p>
            </section>
          )}

          {content?.citations && content.citations.length > 0 && (
            <section class="content-section animate-on-scroll">
              <h3>Publications</h3>
              <ul class="citation-list">
                {content.citations.map((citation) => (
                  <li class="citation-item">{citation}</li>
                ))}
              </ul>
            </section>
          )}
        </div>

        <aside class="detail-sidebar animate-on-scroll">
          {content?.collaborators && content.collaborators.length > 0 && (
            <div class="sidebar-block">
              <h4>Collaborators</h4>
              <ul class="sidebar-list">
                {content.collaborators.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          )}

          {content?.links && content.links.length > 0 && (
            <div class="sidebar-block">
              <h4>Links</h4>
              <div class="sidebar-links">
                {content.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener" class="sidebar-link">
                    {link.label} ↗
                  </a>
                ))}
              </div>
            </div>
          )}
        </aside>
      </div>

      <nav class="project-nav animate-on-scroll">
        {prevProject && (
          <a href={`${base}/research/${prevProject.id}`} class="nav-prev">
            <span class="nav-label">← Previous</span>
            <span class="nav-title">{prevProject.data.title}</span>
          </a>
        )}
        {nextProject && (
          <a href={`${base}/research/${nextProject.id}`} class="nav-next">
            <span class="nav-label">Next →</span>
            <span class="nav-title">{nextProject.data.title}</span>
          </a>
        )}
      </nav>
    </div>
  </article>

  <Footer />
</Layout>

<style>
  .project-detail {
    padding-top: calc(var(--header-height) + var(--space-3xl));
  }

  .detail-header {
    max-width: 800px;
    margin-bottom: var(--space-2xl);
  }

  .hero-image {
    margin-bottom: var(--space-3xl);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 560px;
  }

  .detail-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .detail-date {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .detail-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1.15;
    margin-bottom: var(--space-md);
  }

  .detail-subtitle {
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 640px;
  }

  .awards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .award-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0.35rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 500;
    background: var(--accent-dim);
    color: var(--accent-primary);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-sm);
  }

  .detail-body {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .content-section {
    margin-bottom: var(--space-2xl);
  }

  .content-section h3 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-md);
  }

  .description {
    font-size: 1rem;
    line-height: 1.9;
    max-width: 680px;
  }

  .citation-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .citation-item {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--text-secondary);
    padding-left: var(--space-md);
    border-left: 2px solid var(--border-subtle);
  }

  .detail-sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-xl));
  }

  .sidebar-block {
    margin-bottom: var(--space-xl);
  }

  .sidebar-block h4 {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-sm);
  }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sidebar-list li {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .sidebar-link {
    font-size: 0.85rem;
    color: var(--accent-primary);
    transition: opacity var(--duration-fast);
  }

  .sidebar-link:hover {
    opacity: 0.7;
  }

  .project-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xl);
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-subtle);
  }

  .nav-prev, .nav-next {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 50%;
  }

  .nav-next {
    margin-left: auto;
    text-align: right;
  }

  .nav-label {
    font-size: 0.7rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav-title {
    font-size: 0.9rem;
    font-weight: 500;
    transition: color var(--duration-fast);
  }

  .nav-prev:hover .nav-title,
  .nav-next:hover .nav-title {
    color: var(--accent-primary);
  }

  @media (max-width: 768px) {
    .detail-body {
      grid-template-columns: 1fr;
    }
    .detail-sidebar {
      position: static;
      padding-top: var(--space-xl);
      border-top: 1px solid var(--border-subtle);
    }
    .project-nav {
      flex-direction: column;
    }
    .nav-prev, .nav-next {
      max-width: 100%;
    }
    .nav-next { text-align: left; }
  }
</style>
