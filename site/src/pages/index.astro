---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const featured = projects.slice(0, 6);
---

<Layout title="Arata Horie — Haptics & Embodied Experience Researcher">
  <Header />

  <section class="hero">
    <div class="container hero-layout">
      <div class="hero-text">
        <p class="hero-eyebrow animate-on-scroll">Haptics × Embodied Experience</p>
        <h1 class="hero-title animate-on-scroll">
          Crafting<br/>
          the <em>Sense</em><br/>
          of Touch
        </h1>
        <p class="hero-desc animate-on-scroll">
          Designing body-surface haptic devices and embodied<br class="hide-mobile"/>
          experiences at the intersection of HCI and perception.
        </p>
        <div class="hero-actions animate-on-scroll">
          <a href="/research" class="btn btn-primary">View Research →</a>
          <a href="/about" class="btn btn-outline">About</a>
        </div>
      </div>

      <aside class="hero-aside animate-on-scroll">
        <div class="aside-block">
          <span class="aside-label">Position</span>
          <span class="aside-value">Project Asst. Professor</span>
          <span class="aside-sub">Keio Media Design</span>
        </div>
        <hr class="rule" />
        <div class="aside-block">
          <span class="aside-label">Role</span>
          <span class="aside-value">CTO</span>
          <span class="aside-sub">commissure Inc.</span>
        </div>
        <hr class="rule" />
        <div class="aside-block">
          <span class="aside-label">Focus</span>
          <span class="aside-value">Body Surface × Experience</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section work-section">
    <div class="container">
      <div class="section-head animate-on-scroll">
        <span class="section-label">Selected Work</span>
        <h2>Recent Research</h2>
      </div>
      <div class="work-grid">
        {featured.map((project, i) => (
          <ProjectCard {...project} index={i} />
        ))}
      </div>
      <div class="section-footer animate-on-scroll">
        <a href="/research" class="btn btn-outline">All {projects.length} Projects →</a>
      </div>
    </div>
  </section>

  <section class="numbers-section">
    <div class="container">
      <div class="numbers-grid stagger animate-on-scroll">
        <div class="number-item">
          <span class="number-value">{projects.length}</span>
          <span class="number-label">Research Projects</span>
        </div>
        <div class="number-item">
          <span class="number-value">7+</span>
          <span class="number-label">Years in Haptics HCI</span>
        </div>
        <div class="number-item">
          <span class="number-value">2</span>
          <span class="number-label">Affiliations</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-teaser">
    <div class="container teaser-layout animate-on-scroll">
      <div class="teaser-left">
        <span class="section-label">About</span>
        <h2>Building haptic technologies<br/>that enrich embodied experience</h2>
      </div>
      <div class="teaser-right">
        <p>
          From wearable skin-stretch devices to room-scale encountered haptics,
          I explore how tactile feedback can transform the way we perceive and
          interact with both physical and digital environments.
        </p>
        <a href="/about" class="read-link">
          More about me →
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--header-height);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-3xl);
    align-items: center;
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-3xl);
  }

  .hero-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
    margin-bottom: var(--space-lg);
  }

  .hero-title {
    margin-bottom: var(--space-xl);
    line-height: 1.05;
  }

  .hero-title em {
    font-style: italic;
    color: var(--accent-primary);
  }

  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: var(--space-2xl);
    max-width: 480px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-xl);
  }

  .aside-block {
    display: flex;
    flex-direction: column;
  }

  .aside-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
    margin-bottom: 2px;
  }

  .aside-value {
    font-weight: 500;
    font-size: 0.95rem;
  }

  .aside-sub {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-top: 1px;
  }

  .section-head {
    margin-bottom: var(--space-2xl);
  }

  .section-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
    margin-bottom: var(--space-sm);
  }

  .section-footer {
    text-align: center;
    margin-top: var(--space-2xl);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .numbers-section {
    padding: var(--space-3xl) 0;
    background: var(--bg-secondary);
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    text-align: center;
    gap: var(--space-2xl);
  }

  .number-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .number-value {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    color: var(--accent-primary);
    line-height: 1;
  }

  .number-label {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .teaser-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .teaser-left h2 {
    margin-top: var(--space-sm);
    line-height: 1.3;
  }

  .teaser-right {
    padding-top: var(--space-2xl);
  }

  .teaser-right p {
    font-size: 1rem;
    line-height: 1.9;
    margin-bottom: var(--space-lg);
  }

  .read-link {
    font-size: 0.85rem;
    color: var(--accent-primary);
    font-weight: 500;
    transition: opacity var(--duration-fast);
  }

  .read-link:hover {
    opacity: 0.7;
  }

  .hide-mobile { display: inline; }

  @media (max-width: 1024px) {
    .work-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
    .hero-aside {
      border-left: none;
      border-top: 1px solid var(--border-subtle);
      padding-left: 0;
      padding-top: var(--space-lg);
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-xl);
    }
    .hero-title { font-size: 2.5rem; }
    .hide-mobile { display: none; }
    .work-grid { grid-template-columns: 1fr; }
    .teaser-layout { grid-template-columns: 1fr; gap: var(--space-xl); }
    .teaser-right { padding-top: 0; }
    .numbers-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
