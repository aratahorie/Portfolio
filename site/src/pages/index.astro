---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('research');
projects.sort((a, b) => b.data.date.localeCompare(a.data.date));
const featured = projects.slice(0, 6);
const base = import.meta.env.BASE_URL;
---

<Layout title="Arata Horie — Haptics & Embodied Experience Researcher">
  <Header />

  <section class="hero">
    <HeroCanvas />
    <div class="container hero-layout">
      <!-- Row 1: Photo + Name/Titles, height-matched -->
      <div class="hero-identity animate-on-scroll">
        <div class="hero-photo">
          <img src={`${base}/images/profile.jpg`} alt="Arata Horie" loading="eager" />
        </div>
        <div class="hero-info">
          <h1 class="hero-name">
            Arata Horie<span class="name-ja"> / 堀江 新</span>
          </h1>
          <div class="hero-titles">
            <div class="hero-title-item">
              <span class="title-role">Project Senior Assistant Professor</span>
              <span class="title-org">Keio University Graduate School of Media Design<span class="title-ja"> / 慶應義塾大学KMD</span></span>
            </div>
            <div class="hero-title-item">
              <span class="title-role">Founder & CTO</span>
              <span class="title-org">commissure Inc.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2: Bio + Keywords + Actions -->
      <div class="hero-details animate-on-scroll">
        <div class="hero-bio">
          <p>
            Working toward a better relationship between humans and information technology through the dual engines of academia and business — pursuing an understanding of embodiment and driving research, development, and social implementation centered on HCI and haptic technology.
          </p>
          <p class="bio-ja">
            アカデミアとビジネスの両輪で人間と情報技術のより良い関係性の構築に取り組んでいます。
            身体性の理解を追求し、Human Computer Interaction、触覚技術（ハプティクス）を中心とした研究開発と社会実装を推進しています。
          </p>
        </div>

        <div class="hero-keywords">
          <span class="hero-kw">Haptic Presentation</span>
          <span class="hero-kw">Haptic Sensing</span>
          <span class="hero-kw">Physical AI</span>
          <span class="hero-kw">Embodied Interaction</span>
          <span class="hero-kw">Human-Computer Interaction</span>
          <span class="hero-kw">Wearable Devices</span>
          <span class="hero-kw">Body-Surface Interface</span>
          <span class="hero-kw">Intercorporeality</span>
        </div>

        <div class="hero-actions">
          <a href={`${base}/research`} class="btn btn-primary">View Research →</a>
          <a href={`${base}/about`} class="btn btn-outline">About</a>
          <a href={`${base}/cv`} class="btn btn-outline">CV</a>
          <a href="https://scholar.google.com/citations?user=OFt87kQAAAAJ&hl=en" target="_blank" rel="noopener" class="btn btn-outline">Google Scholar ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section work-section">
    <div class="container">
      <div class="section-head animate-on-scroll">
        <span class="section-label">Selected Work</span>
        <h2>Recent Research Projects<span class="h2-ja"> / 最近の研究プロジェクト</span></h2>
      </div>
      <div class="work-grid">
        {featured.map((project, i) => (
          <ProjectCard
            title={project.data.title}
            subtitle={project.data.subtitle}
            date={project.data.date}
            category={project.data.category}
            slug={project.id}
            image={project.data.image}
            index={i}
          />
        ))}
      </div>
      <div class="section-footer animate-on-scroll">
        <a href={`${base}/research`} class="btn btn-outline">All {projects.length} Projects →</a>
      </div>
    </div>
  </section>

  {/* 
  <section class="numbers-section">
    <div class="container">
      <div class="numbers-grid stagger animate-on-scroll">
        <div class="number-item">
          <span class="number-value">{projects.length}</span>
          <span class="number-label">Research Projects<span class="num-ja"> / 研究プロジェクト</span></span>
        </div>
        <div class="number-item">
          <span class="number-value">70+</span>
          <span class="number-label">Publications<span class="num-ja"> / 論文発表</span></span>
        </div>
        <div class="number-item">
          <span class="number-value">3</span>
          <span class="number-label">Patents<span class="num-ja"> / 特許</span></span>
        </div>
        <div class="number-item">
          <span class="number-value">4</span>
          <span class="number-label">Products<span class="num-ja"> / プロダクト</span></span>
        </div>
      </div>
    </div>
  </section> 
  */}

  <section class="section dual-axis">
    <div class="container">
      <div class="axis-grid">
        <div class="axis-card animate-on-scroll">
          <span class="axis-label">Academia</span>
          <h3>アカデミアでの学術研究</h3>
          <p class="axis-sub-en">Academic Research</p>
          <div class="axis-body">
            <p class="axis-ja">
              慶應義塾大学メディアデザイン研究科にて、触覚提示・触覚センシング等の技術を開発し、様々な現場でプロジェクト化。基礎研究だけでなく、デザインの視点から研究を推進しています。
            </p>
            <p class="axis-en">
              At Keio University Graduate School of Media Design, I introduce technologies such as haptic display and haptic sensing to various fields. I conduct research from a design perspective through communication, not only in basic research.
            </p>
          </div>
          <a href={`${base}/research`} class="read-link">Research →</a>
        </div>
        <div class="axis-card animate-on-scroll">
          <span class="axis-label">Business</span>
          <h3>ビジネスでの社会実装</h3>
          <p class="axis-sub-en">Deploy through business</p>
          <div class="axis-body">
            <p class="axis-ja">
              commissure Inc. CTOとして、これまで培ってきた触覚に関する知見を元に、FeelFuse®・SenseFuse®・ HaptoScala®・HaptoAI®
              としてプロダクト化。技術をビジネスにおける価値に展開し、社会実装を推進します。
            </p>
            <p class="axis-en">
              As CTO of commissure Inc., I productize our accumulated knowledge and patents of haptics into FeelFuse®, SenseFuse®, HaptoScala®, and HaptoAI®, driving the social implementation of technology as value in business.
            </p>
          </div>
          <a href={`${base}/business`} class="read-link">Business →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-teaser">
    <div class="container teaser-layout animate-on-scroll">
      <div class="teaser-left">
        <span class="section-label">About</span>
        <h2>Understanding Embodiment<br/>through Designing Experience</h2>
        <p class="teaser-sub-ja">体験のデザインを通じて身体性を理解する</p>
      </div>
      <div class="teaser-right">
        <div class="teaser-block-en">
          <p>
            Bridging fundamental research in academia and social implementation through commissure —
            expanding the possibilities of haptics through the dual engines of research that "understands"
            and business that "designs" experiences.
          </p>
        </div>
        <div class="teaser-block-ja">
          <p>
            アカデミアでの研究と、commissureでの社会実装を通じて、
             身体性の理解を追求し、Human Computer Interaction、触覚技術を中心とした研究開発と社会実装を推進しています。
          </p>
        </div>
        <a href={`${base}/contact`} class="read-link">Contact →</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    padding-top: var(--header-height);
    overflow: hidden;
  }

  .hero-layout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-xl);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Row 1: Identity — photo + name/titles side by side */
  .hero-identity {
    display: flex;
    align-items: center;
    gap: var(--space-2xl);
  }

  .hero-photo {
    flex-shrink: 0;
  }

  .hero-photo img {
    width: 200px;
    height: 200px;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 50%;
    border: 3px solid var(--border-subtle);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    transition: border-color var(--duration-normal), box-shadow var(--duration-normal);
  }

  .hero-photo img:hover {
    border-color: var(--accent-primary);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.35), 0 0 0 1px var(--accent-primary);
  }

  .hero-info {
    display: flex;
    flex-direction: column;
  }

  .hero-name {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1.2;
    margin-bottom: var(--space-md);
  }

  .name-ja {
    font-family: var(--font-ja);
    font-size: 0.45em;
    color: var(--text-tertiary);
    font-weight: 300;
  }

  .hero-titles {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .hero-title-item {
    display: flex;
    flex-direction: column;
  }

  .title-role {
    font-size: 0.88rem;
    font-weight: 500;
  }

  .title-org {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .title-ja {
    font-family: var(--font-ja);
    font-size: 0.9em;
    color: var(--text-tertiary);
  }

  /* Row 2: Details — bio, keywords, actions */
  .hero-details {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-xl);
  }

  .hero-bio {
    margin-bottom: var(--space-lg);
  }

  .hero-bio p {
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .hero-bio .bio-ja {
    font-family: var(--font-ja);
    font-size: 0.82rem;
    color: var(--text-tertiary);
    margin-top: var(--space-xs);
  }

  .hero-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }

  .hero-kw {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    font-size: 0.7rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    transition: all var(--duration-fast);
  }

  .hero-kw:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    background: var(--accent-dim);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .section-head {
    margin-bottom: var(--space-2xl);
  }

  .section-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
    margin-bottom: var(--space-sm);
  }

  .h2-ja {
    font-family: var(--font-ja);
    font-size: 0.6em;
    font-weight: 300;
    color: var(--text-tertiary);
  }

  .section-footer {
    text-align: center;
    margin-top: var(--space-2xl);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .numbers-section {
    padding: var(--space-3xl) 0;
    background: var(--bg-secondary);
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    text-align: center;
    gap: var(--space-2xl);
  }

  .number-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .number-value {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    color: var(--accent-primary);
    line-height: 1;
  }

  .number-label {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .num-ja {
    font-family: var(--font-ja);
    font-size: 0.9em;
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.7;
  }

  /* Dual Axis */
  .axis-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .axis-card {
    padding: var(--space-2xl);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-normal), box-shadow var(--duration-normal);
  }

  .axis-card:hover {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-card);
  }

  .axis-label {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
    margin-bottom: var(--space-md);
  }

  .axis-card h3 {
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
    line-height: 1.4;
    font-family: var(--font-ja);
  }

  .axis-sub-en {
    font-family: var(--font-en);
    font-size: 0.82rem;
    color: var(--text-tertiary);
    font-style: italic;
    margin-bottom: var(--space-lg);
  }

  .axis-body {
    margin-bottom: var(--space-lg);
  }

  .axis-ja {
    font-family: var(--font-ja);
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border-subtle);
  }

  .axis-en {
    font-family: var(--font-en);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-tertiary);
  }

  .teaser-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .teaser-left h2 {
    margin-top: var(--space-sm);
    line-height: 1.3;
  }

  .teaser-sub-ja {
    font-family: var(--font-ja);
    font-size: 0.88rem;
    color: var(--text-tertiary);
    margin-top: var(--space-sm);
  }

  .teaser-right {
    padding-top: var(--space-2xl);
  }

  .teaser-block-en p {
    font-size: 1rem;
    line-height: 1.9;
  }

  .teaser-block-ja {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
  }

  .teaser-block-ja p {
    font-family: var(--font-ja);
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--text-tertiary);
    margin-bottom: var(--space-md);
  }

  .read-link {
    font-size: 0.85rem;
    color: var(--accent-primary);
    font-weight: 500;
    transition: opacity var(--duration-fast);
  }

  .read-link:hover {
    opacity: 0.7;
  }

  .hide-mobile { display: inline; }

  @media (max-width: 1024px) {
    .work-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .hero-layout {
      text-align: center;
    }
    .hero-identity {
      flex-direction: column;
      gap: var(--space-lg);
    }
    .hero-photo img {
      width: 160px;
      height: 160px;
    }
    .hero-info { align-items: center; }
    .hero-name { font-size: 1.8rem; }
    .hero-titles { align-items: center; }
    .hero-title-item { align-items: center; }
    .hero-keywords { justify-content: center; }
    .hero-actions { justify-content: center; }
    .hide-mobile { display: none; }
    .work-grid { grid-template-columns: 1fr; }
    .axis-grid { grid-template-columns: 1fr; }
    .teaser-layout { grid-template-columns: 1fr; gap: var(--space-xl); }
    .teaser-right { padding-top: 0; }
    .numbers-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
