---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="CV — Arata Horie">
  <Header />

  <section class="cv-page">
    <div class="container">
      <header class="page-header animate-on-scroll">
        <span class="section-label">Curriculum Vitae</span>
        <h1>CV</h1>
      </header>

      <div class="cv-content animate-on-scroll">
        <div class="cv-actions">
          <a href="/cv/Arata_Horie.pdf" target="_blank" class="btn btn-primary" download>
            Download PDF →
          </a>
          <a href="/cv/Arata_Horie.pdf" target="_blank" class="btn btn-outline">
            Open in Browser ↗
          </a>
        </div>

        <div class="cv-embed">
          <iframe
            src="/cv/Arata_Horie.pdf"
            title="Arata Horie CV"
            loading="lazy"
          ></iframe>
          <div class="cv-fallback">
            <p>PDF viewer may not be available in your browser.</p>
            <a href="/cv/Arata_Horie.pdf" class="link-accent">Download the CV directly →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .cv-page {
    padding-top: calc(var(--header-height) + var(--space-3xl));
    min-height: 100vh;
  }

  .page-header {
    margin-bottom: var(--space-2xl);
  }

  .section-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
    margin-bottom: var(--space-sm);
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.04em;
  }

  .cv-actions {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
    flex-wrap: wrap;
  }

  .cv-embed {
    position: relative;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-card);
  }

  .cv-embed iframe {
    width: 100%;
    height: 80vh;
    border: none;
    display: block;
  }

  .cv-fallback {
    display: none;
    padding: var(--space-3xl);
    text-align: center;
  }

  .cv-fallback p {
    margin-bottom: var(--space-md);
  }

  .link-accent {
    color: var(--accent-primary);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .cv-embed iframe {
      height: 60vh;
    }
  }
</style>
