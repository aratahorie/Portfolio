---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About — Arata Horie">
  <Header />

  <section class="about-page">
    <div class="container">
      <header class="about-header animate-on-scroll">
        <span class="section-label">About</span>
        <h1>Arata Horie</h1>
      </header>

      <div class="about-layout">
        <div class="about-main">
          <div class="intro animate-on-scroll">
            <p>
              Arata Horie is a <strong>Project Assistant Professor</strong> at <strong>Keio University Graduate School of Media Design</strong> (Embodied Media).
              He is also the <strong>Representative Director & CTO</strong> of <a href="https://commissure.co.jp/" target="_blank" rel="noopener" class="link-accent">commissure Inc.</a>
            </p>
            <p>
              His research interest centers on <em>body surface and experience</em> — designing haptic
              devices and embodied interactions that transform information into tactile sensation,
              enabling new ways of perceiving and connecting with the world.
            </p>
          </div>

          <div class="about-section animate-on-scroll">
            <h2>Vision</h2>
            <blockquote class="vision-quote">
              Understanding Haptics through Designing Experience
            </blockquote>
            <p class="vision-text">
              アカデミアでの基礎研究で触覚のメカニズムを解明し、commissure での社会実装を通じて体験をデザインする——
              この両輪によって「できる喜びが循環する社会」の実現を目指しています。
              大学で生まれた知見は commissure の製品（HaptoScala®, SenseFuse, FeelFuse, HaptoAI）として製品化され、
              社会実装の現場から得られたフィードバックが新たな研究テーマとなる。このサイクルがハプティクスの可能性を拡張します。
            </p>
          </div>

          <div class="about-section animate-on-scroll">
            <h2>Research Interests</h2>
            <div class="keywords">
              <span class="keyword">Skin-Stretch Haptics</span>
              <span class="keyword">Wearable Tactile Display</span>
              <span class="keyword">Embodied Interaction</span>
              <span class="keyword">Force Perception</span>
              <span class="keyword">Phantom Sensation</span>
              <span class="keyword">Body-Surface Interface</span>
            </div>
          </div>

          <div class="about-section animate-on-scroll">
            <h2>Education</h2>
            <div class="timeline">
              <div class="timeline-item">
                <span class="tl-period">2019 – 2022</span>
                <div class="tl-content">
                  <span class="tl-title">Ph.D. in Engineering</span>
                  <span class="tl-org">The University of Tokyo</span>
                  <span class="tl-detail">Dept. of Advanced Interdisciplinary Studies · Advisor: Dr. Masahiko Inami</span>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2017 – 2019</span>
                <div class="tl-content">
                  <span class="tl-title">M.S. in Information Science</span>
                  <span class="tl-org">Tohoku University</span>
                  <span class="tl-detail">Dept. of Applied Information Science · Advisor: Dr. Masashi Konyo</span>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2013 – 2017</span>
                <div class="tl-content">
                  <span class="tl-title">B.S. in Mechanical Engineering</span>
                  <span class="tl-org">Tokyo University of Science</span>
                </div>
              </div>
            </div>
          </div>

          <div class="about-section animate-on-scroll">
            <h2>Career</h2>
            <div class="timeline">
              <div class="timeline-item">
                <span class="tl-period">2023 – Present</span>
                <div class="tl-content">
                  <span class="tl-title">Project Assistant Professor</span>
                  <span class="tl-org">Keio University Graduate School of Media Design, Embodied Media</span>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2023 – Present</span>
                <div class="tl-content">
                  <span class="tl-title">CTO</span>
                  <span class="tl-org">commissure Inc.</span>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2022 – 2023</span>
                <div class="tl-content">
                  <span class="tl-title">Project Assistant Professor</span>
                  <span class="tl-org">The University of Tokyo, RCAST, Information Somatics Lab</span>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2019 – 2022</span>
                <div class="tl-content">
                  <span class="tl-title">Research Assistant / JSPS Research Fellow DC2</span>
                  <span class="tl-org">Information Somatics Lab, The University of Tokyo</span>
                </div>
              </div>
            </div>
          </div>

          <div class="about-section animate-on-scroll">
            <h2>Grants</h2>
            <div class="timeline">
              <div class="timeline-item">
                <span class="tl-period">2021 – 2023</span>
                <div class="tl-content">
                  <span class="tl-title">ACT-X Hardware in Future for Resilience of Real Space</span>
                  <span class="tl-org">JST</span>
                  <span class="tl-detail">Design of Self-other Inseparable Intercorporeality Through Body Surface Deformation Device</span>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2020 – 2021</span>
                <div class="tl-content">
                  <span class="tl-title">JSPS DC2</span>
                  <span class="tl-org">Japan Society for Promotion of Science</span>
                  <span class="tl-detail">Self-motion Sensation Induction by the Presentation of Distributed Force</span>
                </div>
              </div>
            </div>
          </div>

          <div class="about-section animate-on-scroll">
            <h2>Teaching</h2>
            <div class="timeline">
              <div class="timeline-item">
                <span class="tl-period">2023 – Present</span>
                <div class="tl-content">
                  <span class="tl-title">Guest Lecturer — Otherness and Interaction Technology in Embodied Interaction</span>
                  <span class="tl-org">Keio University Graduate School of Media Design</span>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2023 – Present</span>
                <div class="tl-content">
                  <span class="tl-title">Lecturer — Digital Interaction Prototyping</span>
                  <span class="tl-org">Keio University Graduate School of Media Design</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <aside class="about-sidebar animate-on-scroll">
          <div class="sidebar-card">
            <div class="profile-photo">
              <img src="/images/profile.jpg" alt="Arata Horie" loading="eager" />
            </div>

            <div class="sidebar-group">
              <h4>Affiliations</h4>
              <div class="affiliation">
                <span class="af-role">Project Asst. Professor</span>
                <span class="af-org">Keio Media Design</span>
              </div>
              <div class="affiliation">
                <span class="af-role">CTO</span>
                <span class="af-org">commissure Inc.</span>
              </div>
            </div>

            <hr class="rule" />

            <div class="sidebar-group">
              <h4>Contact</h4>
              <a href="https://twitter.com/ArataHorie" target="_blank" rel="noopener" class="contact-link">X (Twitter) ↗</a>
              <a href="mailto:a.horie@commissure.co.jp" class="contact-link">a.horie@commissure.co.jp</a>
            </div>

            <hr class="rule" />

            <div class="sidebar-group">
              <h4>CV</h4>
              <a href="/cv" class="btn btn-outline" style="width:100%;justify-content:center;">View CV →</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .about-page {
    padding-top: calc(var(--header-height) + var(--space-3xl));
  }

  .about-header {
    margin-bottom: var(--space-3xl);
  }

  .about-header h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    margin-top: var(--space-sm);
  }

  .section-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
  }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .intro p {
    font-size: 1.05rem;
    line-height: 1.9;
    margin-bottom: var(--space-lg);
    max-width: 640px;
  }

  .intro strong { font-weight: 600; }
  .intro em { color: var(--accent-primary); font-style: italic; }

  .link-accent {
    color: var(--accent-primary);
    border-bottom: 1px solid var(--border-accent);
    transition: opacity var(--duration-fast);
  }
  .link-accent:hover { opacity: 0.7; }

  .about-section {
    margin-top: var(--space-2xl);
  }

  .about-section h2 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-lg);
  }

  .vision-quote {
    font-size: 1.4rem;
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--accent-primary);
    border-left: 3px solid var(--accent-primary);
    padding-left: var(--space-lg);
    margin: 0 0 var(--space-lg) 0;
  }

  .vision-text {
    font-size: 0.92rem;
    line-height: 1.9;
    max-width: 640px;
    color: var(--text-secondary);
  }

  .keywords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .keyword {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    font-size: 0.78rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    transition: all var(--duration-fast);
  }
  .keyword:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    background: var(--accent-dim);
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .timeline-item {
    display: flex;
    gap: var(--space-lg);
    align-items: baseline;
  }

  .tl-period {
    flex-shrink: 0;
    min-width: 120px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .tl-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tl-title {
    font-size: 0.92rem;
    font-weight: 500;
  }

  .tl-org {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .tl-detail {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    font-style: italic;
  }

  /* Sidebar */
  .sidebar-card {
    padding: var(--space-xl);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    position: sticky;
    top: calc(var(--header-height) + var(--space-xl));
  }

  .profile-photo {
    margin: calc(-1 * var(--space-xl)) calc(-1 * var(--space-xl)) var(--space-lg);
    overflow: hidden;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .profile-photo img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .sidebar-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .sidebar-group h4 {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
  }

  .affiliation { display: flex; flex-direction: column; }
  .af-role { font-size: 0.78rem; font-weight: 500; }
  .af-org { font-size: 0.82rem; color: var(--text-secondary); }
  .contact-link {
    font-size: 0.85rem;
    color: var(--accent-primary);
    transition: opacity var(--duration-fast);
  }
  .contact-link:hover { opacity: 0.7; }
  .rule { margin: var(--space-lg) 0; }

  @media (max-width: 768px) {
    .about-layout { grid-template-columns: 1fr; }
    .sidebar-card { position: static; }
    .timeline-item { flex-direction: column; gap: 2px; }
    .tl-period { min-width: auto; }
  }
</style>
