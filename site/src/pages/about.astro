---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title="About — Arata Horie">
  <Header />

  <section class="about-page">
    <div class="container">
      <header class="about-header animate-on-scroll">
        <!-- <span class="section-label">About</span> -->
        <h1>Arata Horie<span class="name-ja"> / 堀江 新</span></h1>
      </header>

      <div class="about-layout">
        <div class="about-main">
          <!-- Introduction: EN block then JA block, separated by border -->
          <div class="intro animate-on-scroll">
            <p>
              Arata Horie is a <strong>Project Senior Assistant Professor</strong> at <strong>Keio University Graduate School of Media Design</strong> (Embodied Media),
              and the <strong>Founder & CTO</strong> of <a href="https://commissure.co.jp/" target="_blank" rel="noopener" class="link-accent">commissure Inc.</a>
              Working toward a better relationship between humans and information technology through the dual engines of academia and business — pursuing an understanding of embodiment and driving research, development, and social implementation centered on HCI and haptic technology.
            </p>
          </div>
          <div class="intro-ja animate-on-scroll">
            <p>
              慶應義塾大学大学院メディアデザイン研究科（Embodied Media）特任講師。
              <a href="https://commissure.co.jp/" target="_blank" rel="noopener" class="link-accent">commissure Inc.</a> 代表取締役 CTO。
              アカデミアとビジネスの両輪で人間と情報技術のより良い関係性の構築に取り組んでいます。 身体性の理解を追求し、Human Computer Interaction、触覚技術を中心とした研究開発と社会実装を推進しています。
            </p>
          </div>

          <div class="about-section animate-on-scroll">
            <h2>Vision</h2>
            <blockquote class="vision-quote">
              Understanding Embodiment through Designing Experience
              <span class="vision-quote-ja">体験のデザインを通じて身体性を理解する</span>
            </blockquote>
            <div class="vision-body">
              <div class="vision-ja">
                <p>
                  エンジニアリングやデザインの手法を用いて身体性を伴う体験をハードウェア・ソフトウェア・コンテンツの側面からデザインし、作ることを通じて身体性そのものを理解することを目指しています。アカデミア・インダストリー問わず、様々なパートナーと共に触覚提示・触覚センシング・Physical AI等の研究開発に取り組んでいます。
                </p>
              </div>
              <div class="vision-en">
                <p>
                  I aim to understand embodiment itself through designing and creating embodied experiences across hardware, software, and content — using methodologies from both engineering and design. I engage in research and development spanning haptic presentation, haptic sensing, Physical AI, and more, in collaboration with diverse partners across academia and industry.
                </p>
              </div>
            </div>
          </div>

          <div class="about-section animate-on-scroll">
            <h2>Research Interests</h2>
            <div class="keywords">
              <span class="keyword">Haptic Presentation</span>
              <span class="keyword">Haptic Sensing</span>
              <span class="keyword">Physical AI</span>
              <span class="keyword">Embodied Interaction</span>
              <span class="keyword">Human-Computer Interaction</span>
              <span class="keyword">Wearable Devices</span>
              <span class="keyword">Body-Surface Interface</span>
              <span class="keyword">Intercorporeality</span>
            </div>
          </div>

          <!-- Education: two-column EN | JA per entry -->
          <div class="about-section animate-on-scroll">
            <h2>Education<span class="h2-ja"> / 学歴</span></h2>
            <div class="timeline">
              <div class="timeline-item">
                <span class="tl-period">2019 – 2022</span>
                <div class="tl-cols">
                  <div class="tl-en">
                    <span class="tl-title">Ph.D. in Engineering</span>
                    <span class="tl-org">The University of Tokyo</span>
                    <span class="tl-detail">Dept. of Advanced Interdisciplinary Studies<br/>Advisor: Prof. Masahiko Inami</span>
                  </div>
                  <div class="tl-ja">
                    <span class="tl-title">博士（工学）</span>
                    <span class="tl-org">東京大学</span>
                    <span class="tl-detail">先端学際工学専攻<br/>指導教員: 稲見 昌彦 教授</span>
                  </div>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2017 – 2019</span>
                <div class="tl-cols">
                  <div class="tl-en">
                    <span class="tl-title">M.S. in Information Science</span>
                    <span class="tl-org">Tohoku University</span>
                    <span class="tl-detail">Dept. of Applied Information Science<br/>Advisor: Prof. Masashi Konyo</span>
                  </div>
                  <div class="tl-ja">
                    <span class="tl-title">修士（情報科学）</span>
                    <span class="tl-org">東北大学</span>
                    <span class="tl-detail">応用情報科学専攻<br/>指導教員: 昆陽 雅司 教授</span>
                  </div>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2013 – 2017</span>
                <div class="tl-cols">
                  <div class="tl-en">
                    <span class="tl-title">B.S. in Mechanical Engineering</span>
                    <span class="tl-org">Tokyo University of Science</span>
                  </div>
                  <div class="tl-ja">
                    <span class="tl-title">学士（工学）</span>
                    <span class="tl-org">東京理科大学</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Career: two-column -->
          <div class="about-section animate-on-scroll">
            <h2>Career<span class="h2-ja"> / 職歴</span></h2>
            <div class="timeline">
              <div class="timeline-item">
                <span class="tl-period">2023 – Present</span>
                <div class="tl-cols">
                  <div class="tl-en">
                    <span class="tl-title">Founder & CTO</span>
                    <span class="tl-org">commissure Inc.</span>
                  </div>
                  <div class="tl-ja">
                    <span class="tl-title">代表取締役 CTO</span>
                    <span class="tl-org">commissure Inc.</span>
                  </div>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2026 – Present</span>
                <div class="tl-cols">
                  <div class="tl-en">
                    <span class="tl-title">Project Senior Assistant Professor</span>
                    <span class="tl-org">Keio University Graduate School of Media Design</span>
                  </div>
                  <div class="tl-ja">
                    <span class="tl-title">特任講師</span>
                    <span class="tl-org">慶應義塾大学大学院メディアデザイン研究科</span>
                  </div>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2023 – 2026</span>
                <div class="tl-cols">
                  <div class="tl-en">
                    <span class="tl-title">Project Assistant Professor</span>
                    <span class="tl-org">Keio University Graduate School of Media Design</span>
                  </div>
                  <div class="tl-ja">
                    <span class="tl-title">特任助教</span>
                    <span class="tl-org">慶應義塾大学大学院メディアデザイン研究科</span>
                  </div>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2022 – 2023</span>
                <div class="tl-cols">
                  <div class="tl-en">
                    <span class="tl-title">Project Assistant Professor</span>
                    <span class="tl-org">The University of Tokyo, RCAST</span>
                    <span class="tl-detail">Information Somatics Lab</span>
                  </div>
                  <div class="tl-ja">
                    <span class="tl-title">特任助教</span>
                    <span class="tl-org">東京大学 先端科学技術研究センター</span>
                    <span class="tl-detail">身体情報学分野</span>
                  </div>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2019 – 2022</span>
                <div class="tl-cols">
                  <div class="tl-en">
                    <span class="tl-title">Research Assistant / JSPS DC2</span>
                    <span class="tl-org">The University of Tokyo</span>
                    <span class="tl-detail">Information Somatics Lab</span>
                  </div>
                  <div class="tl-ja">
                    <span class="tl-title">RA / 日本学術振興会 特別研究員 DC2</span>
                    <span class="tl-org">東京大学</span>
                    <span class="tl-detail">身体情報学分野</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Grants: two-column -->
          <div class="about-section animate-on-scroll">
            <h2>Grants<span class="h2-ja"> / 研究費</span></h2>
            <div class="timeline">
              <div class="timeline-item">
                <span class="tl-period">2021 – 2023</span>
                <div class="tl-cols">
                  <div class="tl-en">
                    <span class="tl-title">ACT-X</span>
                    <span class="tl-org">JST</span>
                    <span class="tl-detail">Design of Self-other Inseparable Intercorporeality Through Body Surface Deformation Device</span>
                  </div>
                  <div class="tl-ja">
                    <span class="tl-title">ACT-X</span>
                    <span class="tl-org">科学技術振興機構</span>
                    <span class="tl-detail">体表面変形デバイスによる自他不可分な間身体性の設計</span>
                  </div>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2020 – 2021</span>
                <div class="tl-cols">
                  <div class="tl-en">
                    <span class="tl-title">JSPS DC2</span>
                    <span class="tl-org">Japan Society for Promotion of Science</span>
                    <span class="tl-detail">Self-motion Sensation Induction by the Presentation of Distributed Force</span>
                  </div>
                  <div class="tl-ja">
                    <span class="tl-title">特別研究員 DC2</span>
                    <span class="tl-org">日本学術振興会</span>
                    <span class="tl-detail">分布力覚提示による自己運動感覚の誘発</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Teaching -->
          <div class="about-section animate-on-scroll">
            <h2>Teaching<span class="h2-ja"> / 教育</span></h2>
            <div class="timeline">
              <div class="timeline-item">
                <span class="tl-period">2023 – Present</span>
                <div class="tl-content-simple">
                  <span class="tl-title">Otherness and Interaction Technology in Embodied Interaction</span>
                  <span class="tl-detail">Guest Lecturer · Keio University Graduate School of Media Design</span>
                </div>
              </div>
              <div class="timeline-item">
                <span class="tl-period">2023 – Present</span>
                <div class="tl-content-simple">
                  <span class="tl-title">Digital Interaction Prototyping</span>
                  <span class="tl-detail">Lecturer · Keio University Graduate School of Media Design</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <aside class="about-sidebar animate-on-scroll">
          <div class="sidebar-card">
            <div class="profile-photo">
              <img src={`${base}/images/profile.jpg`} alt="Arata Horie" loading="eager" />
            </div>

            <div class="sidebar-group">
              <h4>Affiliations<span class="h4-ja"> / 所属</span></h4>
              <div class="affiliation">
                <span class="af-role">Project Sr. Asst. Professor<span class="af-ja"> / 特任講師</span></span>
                <span class="af-org">Keio Media Design</span>
              </div>
              <div class="affiliation">
                <span class="af-role">Founder &amp; CTO</span>
                <span class="af-org">commissure Inc.</span>
              </div>
            </div>

            <hr class="rule" />

            <div class="sidebar-group">
              <h4>Contact</h4>
              <a href="https://twitter.com/ArataHorie" target="_blank" rel="noopener" class="contact-link">X (Twitter) ↗</a>
              <a href="mailto:a.horie@commissure.co.jp" class="contact-link">a.horie@commissure.co.jp</a>
            </div>

            <hr class="rule" />

            <div class="sidebar-group">
              <h4>CV</h4>
              <a href={`${base}/cv`} class="btn btn-outline" style="width:100%;justify-content:center;">View CV →</a>
              <a href="https://scholar.google.com/citations?user=OFt87kQAAAAJ&hl=en" target="_blank" rel="noopener" class="btn btn-outline" style="width:100%;justify-content:center;">Google Scholar ↗</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .about-page {
    padding-top: calc(var(--header-height) + var(--space-3xl));
  }

  .about-header {
    margin-bottom: var(--space-3xl);
  }

  .about-header h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    margin-top: var(--space-sm);
  }

  .name-ja {
    font-family: var(--font-ja);
    font-size: 0.5em;
    color: var(--text-tertiary);
    font-weight: 300;
  }

  .section-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-primary);
  }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-3xl);
    align-items: start;
  }

  /* Intro */
  .intro p {
    font-size: 1.05rem;
    line-height: 1.9;
    max-width: 640px;
  }

  .intro-ja {
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
    margin-bottom: var(--space-lg);
  }

  .intro-ja p {
    font-family: var(--font-ja);
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--text-tertiary);
    max-width: 640px;
  }

  .intro strong { font-weight: 600; }
  .intro em, .intro-ja em { color: var(--accent-primary); font-style: italic; }

  .link-accent {
    color: var(--accent-primary);
    border-bottom: 1px solid var(--border-accent);
    transition: opacity var(--duration-fast);
  }
  .link-accent:hover { opacity: 0.7; }

  .about-section {
    margin-top: var(--space-2xl);
  }

  .about-section h2 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-lg);
  }

  .h2-ja {
    font-family: var(--font-ja);
    font-size: 0.9em;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  /* Vision */
  .vision-quote {
    font-size: 1.4rem;
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--accent-primary);
    border-left: 3px solid var(--accent-primary);
    padding-left: var(--space-lg);
    margin: 0 0 var(--space-lg) 0;
  }

  .vision-quote-ja {
    display: block;
    font-family: var(--font-ja);
    font-size: 0.6em;
    color: var(--text-tertiary);
    font-style: normal;
    margin-top: var(--space-sm);
  }

  .vision-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .vision-ja p {
    font-family: var(--font-ja);
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  .vision-en p {
    font-family: var(--font-en);
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--text-tertiary);
  }

  /* Keywords */
  .keywords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .keyword {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    font-size: 0.78rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    transition: all var(--duration-fast);
  }
  .keyword:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    background: var(--accent-dim);
  }

  /* Timeline — two-column layout */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .tl-period {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }

  .tl-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .tl-en, .tl-ja {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tl-ja {
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-md);
  }

  .tl-ja .tl-title,
  .tl-ja .tl-org,
  .tl-ja .tl-detail {
    font-family: var(--font-ja);
  }

  .tl-title {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .tl-org {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .tl-detail {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  /* Simple timeline for Teaching (no bilingual column needed) */
  .tl-content-simple {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Sidebar */
  .sidebar-card {
    padding: var(--space-xl);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    position: sticky;
    top: calc(var(--header-height) + var(--space-xl));
  }

  .profile-photo {
    margin: calc(-1 * var(--space-xl)) calc(-1 * var(--space-xl)) var(--space-lg);
    overflow: hidden;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .profile-photo img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .sidebar-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .sidebar-group h4 {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
  }

  .h4-ja {
    font-family: var(--font-ja);
    font-size: 0.9em;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  .affiliation { display: flex; flex-direction: column; }
  .af-role { font-size: 0.78rem; font-weight: 500; }
  .af-ja {
    font-family: var(--font-ja);
    font-size: 0.85em;
    color: var(--text-tertiary);
    font-weight: 400;
  }
  .af-org { font-size: 0.82rem; color: var(--text-secondary); }
  .contact-link {
    font-size: 0.85rem;
    color: var(--accent-primary);
    transition: opacity var(--duration-fast);
  }
  .contact-link:hover { opacity: 0.7; }
  .rule { margin: var(--space-lg) 0; }

  @media (max-width: 768px) {
    .about-layout { grid-template-columns: 1fr; }
    .sidebar-card { position: static; }
    .timeline-item { grid-template-columns: 1fr; }
    .tl-period { margin-bottom: 2px; }
    .tl-cols { grid-template-columns: 1fr; }
    .tl-ja { border-left: none; padding-left: 0; border-top: 1px solid var(--border-subtle); padding-top: var(--space-xs); margin-top: var(--space-xs); }
    .vision-body { grid-template-columns: 1fr; }
  }
</style>
